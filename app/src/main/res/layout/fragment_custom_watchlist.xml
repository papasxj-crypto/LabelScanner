<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vintage_parchment"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top-anchored Deletion Confirmation Banner -->
    <LinearLayout
        android:id="@+id/layoutConfirmBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/gradeAvoidBackground"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvConfirmMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Remove ingredient?"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnConfirmDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRM"
            android:backgroundTint="@color/white"
            android:textColor="@color/gradeAvoid"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/btnCancelDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cancel"
            android:padding="4dp"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Active Red Items Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active Custom RED Watchlist"
        android:textColor="@color/gradeAvoid"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp"/>

    <!-- Scrollable container for active Red items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cardSurface"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/layoutRedItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Active Yellow Items Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active Custom YELLOW Watchlist"
        android:textColor="@color/gradeCaution"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="4dp"/>

    <!-- Scrollable container for active Yellow items -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/cardSurface"
        android:padding="8dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/layoutYellowItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surfaceStroke"
        android:layout_marginBottom="16dp"/>

    <!-- Horizontal Scrolling Common Quick Add Panel -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Common Quick Add Items"
        android:textColor="@color/textMuted"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="6dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCommonItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <!-- Entry boxes and adding panel -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Custom Ingredient"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etIngredientInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name (e.g. MSG, SOY)"
        android:textColorHint="@color/textHint"
        android:textColor="@color/textPrimary"
        android:inputType="textCapCharacters"
        android:layout_marginBottom="12dp"
        android:padding="12dp"
        android:background="@color/inputSurface"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnAddRed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add to RED"
            android:backgroundTint="@color/gradeAvoid"
            android:textColor="@color/white"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnAddYellow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add to YELLOW"
            android:backgroundTint="@color/gradeCaution"
            android:textColor="@color/black"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Done / Back Button -->
    <Button
        android:id="@+id/btnBackToHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Done"
        android:backgroundTint="@color/buttonPrimaryBackground"
        android:textColor="@color/buttonPrimaryText"/>

</LinearLayout>