<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/cardSurface"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/surfaceStroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Logo / Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="FilterPoint Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unlock Premium Features"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please subscribe to benefit from this feature and unlock unlimited profiles, custom macro calibration, and advanced AI recipe adjustments."
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpgradeOk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="View Plans"
            android:textColor="@color/buttonPrimaryText"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/buttonPrimaryBackground"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtUpgradeCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not Now"
            android:textColor="@color/textMuted"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>