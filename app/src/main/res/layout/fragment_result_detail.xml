<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vintage_parchment"
    android:fillViewport="true"
    android:transitionName="shared_element_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <!-- Top Navigation Bar: Customary Top-Left Back Arrow -->
        <ImageView
            android:id="@+id/btnBackTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="?attr/homeAsUpIndicator"
            app:tint="#F4F5FC"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Scanner"
            android:layout_marginBottom="8dp" />

        <!-- Scanned Item Result Summary Card -->
        <include
            layout="@layout/card_result_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- SAFER ALTERNATIVES SECTION -->
        <LinearLayout
            android:id="@+id/layoutAlternativesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Try these safer alternatives instead:"
                android:textColor="#81C784"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Alternative Option Card 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlt1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#251B18"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3A2D28">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:background="#81C784"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/textAlt1Name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alternative Option 1"
                            android:textColor="#F4F5FC"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/textAlt1Brand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Brand"
                            android:textColor="#99A1B3"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Alternative Option Card 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlt2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#251B18"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3A2D28">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:background="#81C784"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/textAlt2Name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alternative Option 2"
                            android:textColor="#F4F5FC"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/textAlt2Brand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Brand"
                            android:textColor="#99A1B3"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Alternative Option Card 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlt3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#251B18"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#3A2D28">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="32dp"
                        android:background="#81C784"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/textAlt3Name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alternative Option 3"
                            android:textColor="#F4F5FC"
                            android:textStyle="bold"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/textAlt3Brand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Brand"
                            android:textColor="#99A1B3"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Prominent Primary Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.LabelScanner.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            app:backgroundTint="#2B1F16"
            android:textColor="#F4F5FC"
            android:text="Done (Back to Scanner)" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="80dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>