<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vintage_parchment"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SECTION 1: APP PREFERENCES CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceStroke"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP PREFERENCES"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <!-- Material CheckBox with high-contrast vivid tinting -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_left_handed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Left-Handed Mode"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    app:buttonTint="@color/accentVivid"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aligns Home screen scan buttons to the bottom-left for comfortable left-handed thumb access."
                    android:textColor="@color/textMuted"
                    android:textSize="12sp"
                    android:layout_marginStart="32dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: CUSTOM CONDITION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceStroke"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIETARY TEMPLATES"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create, edit, or clone dietary templates to customize nutrient limits for tailored conditions (such as bodybuilders or recovery plans)."
                    android:textColor="@color/textMuted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Action Button bound cleanly to SettingsActivity -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateCustomProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:text="Create Custom Profile"
                    android:textColor="@color/textPrimary"
                    app:strokeColor="@color/surfaceStroke"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: MASTER ACTION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceStroke"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/buttonSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="@color/buttonPrimaryBackground"
                    android:textColor="@color/buttonPrimaryText"
                    android:textStyle="bold"
                    android:text="@string/save_apply_changes_txt"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>