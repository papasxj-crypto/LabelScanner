<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vintage_parchment"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Navigation Bar: Back Arrow -->
        <ImageView
            android:id="@+id/btnBackTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/textPrimary"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:layout_marginBottom="8dp" />

        <!-- SECTION 1: APP PREFERENCES CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceStroke"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP PREFERENCES"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <!-- Left-Handed Mode CheckBox (Auto-saves on change) -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_left_handed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Left-Handed Mode"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp"
                    app:buttonTint="@color/accentWarm"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aligns Home screen scan buttons to the bottom-left for comfortable left-handed thumb access."
                    android:textColor="@color/textMuted"
                    android:textSize="12sp"
                    android:layout_marginStart="32dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: PROFILE ADMINISTRATION CARD (Single Point: Add & Delete) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceStroke"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILES"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add new profiles to track unique dietary conditions, or remove profiles you no longer need."
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNewProfile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="＋ Add New Profile"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/surfaceStroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/cardSurface"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteProfile"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🗑 Delete Profile"
                    android:textColor="@color/gradeAvoid"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: ABOUT FILTERPOINT & MEDICAL DISCLAIMER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cardSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/surfaceStroke"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABOUT FILTERPOINT"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FilterPoint"
                    android:textColor="@color/textPrimary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Filtering out the bad stuff at the point of decision.&quot;"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:layout_marginTop="2dp" />

                <!-- Dynamic Version Readout -->
                <TextView
                    android:id="@+id/txtAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version 1.0.0"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/surfaceStroke"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CLINICAL &amp; MEDICAL DISCLAIMER"
                    android:textColor="@color/textMuted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="FilterPoint provides nutritional data and ingredient analysis for informational, dietary, and culinary guidance only. It is not medical software, diagnosis, or prescription. Always consult your nephrologist, endocrinologist, or registered dietitian before making significant dietary changes."
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/surfaceStroke"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="© 2026 FilterPoint Software. All rights reserved."
                    android:textColor="@color/textMuted"
                    android:textSize="11sp"
                    android:gravity="center_horizontal" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>