<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vintage_parchment"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <!-- Top Navigation Bar: Customary Top-Left Back Arrow -->
        <ImageView
            android:id="@+id/btnBackTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="?attr/homeAsUpIndicator"
            app:tint="#F4F5FC"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Cookbook"
            android:layout_marginBottom="8dp" />

        <!-- Card 1: Recipe Title & Real-Time Safety Badge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#EA14161F"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#313542"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtRecipeDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recipe Title"
                    android:textColor="#F4F5FC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/txtRecipeDetailBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Verified Safe"
                        android:textColor="#81C784"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRecipeDetailProfile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="For: CKD Stages 1-3"
                        android:textColor="#8C7A6B"
                        android:textSize="11sp"
                        android:gravity="end"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtRecipeDetailSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Source: Original Website Link"
                    android:textColor="#99A1B3"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Adjusted Ingredients Card with Top-Right Re-Profile Button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#251B18"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A2D28"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Row: Dynamic Title (Left) + Re-Profile Action (Right) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/txtDetailIngredientsHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="INGREDIENTS (ADJUSTED)"
                        android:textColor="#4CAF50"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReProfile"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↻ Re-Profile"
                        android:textColor="#FFD54F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDetailIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#F4F5FC"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#3A2D28"
                    android:textColor="#F4F5FC"
                    android:text="Copy Ingredients"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Preparation Instructions Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#251B18"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3A2D28"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEP-BY-STEP PREPARATION"
                    android:textColor="#FFD54F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/txtDetailInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No instructions loaded yet. Tap 'Get Steps' below to generate cooking steps."
                    android:textColor="#99A1B3"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFetchSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#3A2D28"
                    android:textColor="#FFD54F"
                    android:text="Get Steps"
                    android:textSize="12sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>