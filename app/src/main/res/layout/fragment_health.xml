<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Health &amp; Dietary Profiles"
            android:textColor="#E6E1E5"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select your active medical and dietary conditions. LabelScanner evaluates ingredients and macros against these rules."
            android:textColor="#CAC4D0"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <!-- Dynamic Conditions Checkbox Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1D1B20"
            app:cardCornerRadius="12dp"
            app:strokeColor="#49454F"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/containerConditions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Active Dietary Targets"
                    android:textColor="#D0BCFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <!-- Programmatically populated checkboxes go here -->

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Profile Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveHealthProfiles"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Health Profile" />

    </LinearLayout>
</ScrollView>