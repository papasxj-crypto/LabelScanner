<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_vintage_parchment"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Universal Top Tab Bar (Semantic Token Colors) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutHealth"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/transparent"
        app:tabTextColor="@color/textUnselected"
        app:tabSelectedTextColor="@color/textSelected"
        app:tabIndicatorColor="@color/accentVivid"
        app:tabIndicatorHeight="3dp"
        android:layout_marginBottom="12dp">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profiles &amp; Targets" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Watchlist" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Main Scrollable Content Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- ======================================================== -->
            <!-- TAB 1: PROFILES & TARGETS CONTAINER PANEL                -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutTabProfiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Section 1: Clinical Measurements Card (Balanced 2x2 Grid) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLINICAL MEASUREMENTS"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="12dp" />

                        <!-- Row 1: Weight & Gender Side-by-Side -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:layout_marginBottom="12dp">

                            <!-- Weight Column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Actual Weight (lbs)"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="42dp"
                                    android:background="@color/inputSurface"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <EditText
                                        android:id="@+id/etActualWeight"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:background="@color/transparent"
                                        android:textColor="@color/textPrimary"
                                        android:inputType="numberPassword"
                                        android:imeOptions="actionDone"
                                        android:selectAllOnFocus="true"
                                        android:paddingStart="10dp"
                                        android:paddingEnd="4dp"
                                        android:maxLength="5"
                                        android:hint="0"
                                        android:textColorHint="@color/textHint"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/txtToggleWeight"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:text="SHOW"
                                        android:textColor="@color/textSecondary"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:gravity="center"
                                        android:paddingHorizontal="10dp"
                                        android:background="?android:attr/selectableItemBackground"
                                        android:clickable="true"
                                        android:focusable="true" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Gender Column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Biological Gender"
                                    android:textColor="@color/textSecondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp" />

                                <Spinner
                                    android:id="@+id/spinnerGender"
                                    android:layout_width="match_parent"
                                    android:layout_height="42dp"
                                    android:background="@color/inputSurface"
                                    android:paddingHorizontal="8dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Row 2: Height & Stat Badges Side-by-Side -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2"
                            android:gravity="center_vertical">

                            <!-- Height Column -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Height"
                                    android:textColor="@color/textMuted"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="4dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="42dp"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <EditText
                                        android:id="@+id/etHeightFeet"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:background="@color/inputSurface"
                                        android:textColor="@color/textPrimary"
                                        android:inputType="number"
                                        android:imeOptions="actionNext"
                                        android:selectAllOnFocus="true"
                                        android:gravity="center"
                                        android:hint="0"
                                        android:textColorHint="@color/textHint"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" '"
                                        android:textColor="@color/textPrimary"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:layout_marginEnd="4dp" />

                                    <EditText
                                        android:id="@+id/etHeightInches"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:background="@color/inputSurface"
                                        android:textColor="@color/textPrimary"
                                        android:inputType="number"
                                        android:imeOptions="actionDone"
                                        android:selectAllOnFocus="true"
                                        android:gravity="center"
                                        android:hint="0"
                                        android:textColorHint="@color/textHint"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=' "'
                                        android:textColor="@color/textPrimary"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Calculated Outputs (IBW / AjBW) -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_vertical"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:id="@+id/txtIbwCalculated"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/accentVivid"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:layout_marginBottom="2dp"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/txtAjbwCalculated"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/accentWarm"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 2: Clinical Profile Targets Card (Natural Full-Height List) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtClinicalTargetsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CLINICAL TARGETS"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/txtClinicalTargetsSubheader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Long press any profile for details"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutConditionCheckBoxes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section 3: Allergen Watchlist Card (Natural Full-Height List) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtAllergenTargetsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ALLERGEN WATCHLIST"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/txtAllergenTargetsSubheader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Long press any allergen for details"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutAllergenCheckBoxes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dedicated Edit Profile & Sliders Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditActiveProfile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Edit Profile &amp; Sliders"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/surfaceStroke"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/cardSurface"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

            <!-- ======================================================== -->
            <!-- TAB 2: CUSTOM WATCHLIST CONTAINER PANEL                  -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutTabCustomWatchlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Input Section Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ADD CUSTOM WATCHLIST INGREDIENT"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <EditText
                                android:id="@+id/etCustomIngredient"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1.2"
                                android:background="@color/inputSurface"
                                android:textColor="@color/textPrimary"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:hint="Type ingredient (e.g. Soy)"
                                android:textColorHint="@color/textHint"
                                android:textSize="14sp"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddRed"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="0.9"
                                android:backgroundTint="@color/gradeAvoid"
                                android:textColor="@color/white"
                                android:text="+ Avoid"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddYellow"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="0.9"
                                android:backgroundTint="@color/gradeCaution"
                                android:textColor="@color/cardSurface"
                                android:text="+ Caution"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Common Quick Add Chips Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtCommonAddsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="COMMON ADDITIONS (TAP TO WATCHLIST)"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupCommonAdds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="6dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dynamic User Avoid Watchlist Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtActiveRedsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AVOID LIST (RED)"
                            android:textColor="@color/gradeAvoid"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutActiveReds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dynamic User Caution Watchlist Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/cardSurface"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtActiveYellowsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CAUTION LIST (YELLOW)"
                            android:textColor="@color/gradeCaution"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutActiveYellows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>