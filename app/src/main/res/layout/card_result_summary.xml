<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardResult"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:visibility="gone"
    app:cardBackgroundColor="#1E222A"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2E3545">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. SOFT STATUS BANNER -->
        <TextView
            android:id="@+id/textGradeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Looks good for your goals"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#3B6E50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textItemSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nutrient Overview"
                android:textColor="#8A99AD"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- 2. GENTLE GUIDANCE / NOTES BOX -->
            <LinearLayout
                android:id="@+id/layoutViolations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2C2325"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textViolationsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Things to keep in mind:"
                    android:textColor="#E08B7B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/textViolationsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Slightly higher potassium than your target\n• Contains added sugars"
                    android:textColor="#E0D0CC"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- 3. NUTRIENT BREAKDOWN CHIPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipCalories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#282D37"
                    android:padding="12dp"
                    android:text="Calories: --"
                    android:textColor="#D1D7E0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipProtein"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#282D37"
                    android:padding="12dp"
                    android:text="Protein: --"
                    android:textColor="#D1D7E0"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipSodium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#282D37"
                    android:padding="12dp"
                    android:text="Sodium: --"
                    android:textColor="#D1D7E0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipPotassium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#282D37"
                    android:padding="12dp"
                    android:text="Potassium: --"
                    android:textColor="#D1D7E0"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipCarbs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="#282D37"
                    android:padding="12dp"
                    android:text="Carbs: --"
                    android:textColor="#D1D7E0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipSugar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="#282D37"
                    android:padding="12dp"
                    android:text="Sugar: --"
                    android:textColor="#D1D7E0"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>