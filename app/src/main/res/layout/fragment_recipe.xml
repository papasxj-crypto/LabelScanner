<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_recipe_vintage">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <!-- Header Card (Borderless, Floating Title) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recipe Profile &amp; Adjust"
                        android:textColor="@color/textPrimary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:gravity="center"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Input Mode Selector Toggle (Unified Text/Link + Photo, Shaded box removed!) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleInputMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@+id/btnModeText">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeText"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/textPrimary"
                    app:strokeColor="@color/surfaceStrokeColor"
                    android:text="Text / Link" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeOcr"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/textPrimary"
                    app:strokeColor="@color/surfaceStrokeColor"
                    android:text="Photo" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Primary Trigger Action Button (Color updated to soft brown) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjustRecipe"
                style="@style/Widget.LabelScanner.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                app:backgroundTint="#2B1F16"
                android:text="Profile &amp; Adjust" />

            <!-- Side-by-Side Grade Comparison Cards -->
            <LinearLayout
                android:id="@+id/layoutGradeComparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Card 1: Original Recipe Health Grade -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOriginalHealthGrade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/surfaceStrokeColor"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtOriginalGradeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Original Grade"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtOriginalViolations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#40FFFFFF" />

                        <TextView
                            android:id="@+id/txtOriginalStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card 2: Adjusted Recipe Health Grade -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdjustedHealthGrade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/surfaceStrokeColor"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtAdjustedGradeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Adjusted Grade"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtAdjustedViolations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/textPrimary"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#40FFFFFF" />

                        <TextView
                            android:id="@+id/txtAdjustedStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 5. Original Input Box (Translucent Smoke Background & White Hint) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRecipeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Paste recipe lines or website link here"
                app:hintTextColor="@color/white"
                android:textColorHint="@color/white"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/surfaceStrokeColor"
                app:boxStrokeWidth="1dp"
                app:boxBackgroundColor="#4D000000"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtRecipeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="5"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/textPrimary"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Option B: Camera OCR Select Action -->
            <LinearLayout
                android:id="@+id/layoutOcrActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectPhoto"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textColor="@color/textPrimary"
                    app:strokeColor="@color/surfaceStrokeColor"
                    android:text="Select Photo from Gallery"
                    app:icon="@android:drawable/ic_menu_gallery" />
            </LinearLayout>

            <!-- 6. Adjusted Clipboard Output Box (Translucent Smoke Card) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdjustedResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surfaceStrokeColor"
                app:cardBackgroundColor="#4D000000">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/txtAdjustedRecipeHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Adjusted Recipe"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyAdjusted"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copy"
                            android:textColor="@color/textPrimary"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Output floats completely directly on the scale illustration -->
                    <TextView
                        android:id="@+id/txtAdjustedOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:background="@android:color/transparent"
                        android:padding="12dp" />

                    <!-- Phase 2 & 3 Trigger Actions Button Group -->
                    <LinearLayout
                        android:id="@+id/layoutPostAnalysisActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetrieveSteps"
                            style="@style/Widget.LabelScanner.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/textPrimary"
                            android:layout_marginEnd="4dp"
                            android:text="Get Steps" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRetrieveAnalysis"
                            style="@style/Widget.LabelScanner.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/textPrimary"
                            android:layout_marginStart="4dp"
                            android:text="Get Analysis" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>