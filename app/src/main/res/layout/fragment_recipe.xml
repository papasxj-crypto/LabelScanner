<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_recipe_vintage">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <!-- ======================================================== -->
            <!-- STATE 1: RECIPE INPUT SECTION (Hidden during Results)    -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutInputSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Single Integrated Input Surface -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    app:cardBackgroundColor="@color/cardSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Input Header: Inline Import Hub + Servings Counter -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@color/headerSurface"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp">

                            <!-- Unified Import Hub Action (Clipboard, Text File, Photo) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnImportHub"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:text="📂 Import"
                                android:textColor="@color/textPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <!-- Enlarged Servings Counter -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Servings:"
                                android:textColor="@color/textMuted"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="8dp" />

                            <EditText
                                android:id="@+id/edtServingsInput"
                                android:layout_width="60dp"
                                android:layout_height="38dp"
                                android:background="@color/inputSurface"
                                android:gravity="center"
                                android:inputType="number"
                                android:imeOptions="actionDone"
                                android:maxLength="3"
                                android:padding="4dp"
                                android:text="4"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:selectAllOnFocus="true" />
                        </LinearLayout>

                        <!-- Multi-line Text Area -->
                        <EditText
                            android:id="@+id/edtRecipeInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="7"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:background="@color/transparent"
                            android:padding="16dp"
                            android:hint="Paste recipe ingredients or website link here..."
                            android:textColorHint="@color/textHint"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Primary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdjustRecipe"
                    style="@style/Widget.LabelScanner.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginBottom="8dp"
                    app:backgroundTint="@color/buttonPrimaryBackground"
                    android:text="Profile &amp; Adjust" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- STATE 2: RESULTS SECTION (Activated after Analysis)      -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutResultsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Top Result Header Bar (Recipe Name + Re-Profile + Edit Actions) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/txtTopRecipeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recipe Name"
                        android:textColor="@color/textPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- Re-Profile Action (Forces Live AI / Skips Cache) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReProfile"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="↻ Re-Profile"
                        android:textColor="@color/textSecondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="6dp" />

                    <!-- Edit Input Action (Preserves Text for Tweak) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNewRecipe"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="✎ Edit Input"
                        android:textColor="@color/textPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="6dp" />
                </LinearLayout>

                <!-- ======================================================== -->
                <!-- HORIZONTAL DIFFERENTIAL GAUGE HUD CARD                    -->
                <!-- ======================================================== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClinicalGauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    app:cardBackgroundColor="@color/cardSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:id="@+id/txtClinicalImpactHeader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="CLINICAL IMPACT"
                                android:textColor="@color/textMuted"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap for diagnostics ➔"
                                android:textColor="@color/textMuted"
                                android:textSize="10sp"
                                android:textStyle="italic" />
                        </LinearLayout>

                        <!-- GAUGE ROW 1: SODIUM -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SODIUM"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="OG"
                                android:textColor="@color/textHint"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barSodiumOg"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtSodiumOgVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="499 mg"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="ADJ"
                                android:textColor="@color/textSecondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barSodiumAdj"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtSodiumAdjVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="378 mg (-24%)"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- GAUGE ROW 2: POTASSIUM -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="POTASSIUM"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="OG"
                                android:textColor="@color/textHint"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barPotassiumOg"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtPotassiumOgVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="425 mg"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="ADJ"
                                android:textColor="@color/textSecondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barPotassiumAdj"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtPotassiumAdjVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="352 mg (-17%)"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- GAUGE ROW 3: CARBS -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CARBS (NET)"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="OG"
                                android:textColor="@color/textHint"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barCarbsOg"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtCarbsOgVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="9.1 g"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="3dp"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="ADJ"
                                android:textColor="@color/textSecondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barCarbsAdj"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtCarbsAdjVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="31.9 g"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                        <!-- GAUGE ROW 4: PROTEIN -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROTEIN"
                            android:textColor="@color/textMuted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="OG"
                                android:textColor="@color/textHint"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barProteinOg"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtProteinOgVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="19.7 g"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:gravity="end" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="3dp">

                            <TextView
                                android:layout_width="26dp"
                                android:layout_height="wrap_content"
                                android:text="ADJ"
                                android:textColor="@color/textSecondary"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <net.meinook.labelscanner.ClinicalGaugeBar
                                android:id="@+id/barProteinAdj"
                                android:layout_width="0dp"
                                android:layout_height="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="8dp" />

                            <TextView
                                android:id="@+id/txtProteinAdjVal"
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="17.3 g (-12%)"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:gravity="end" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dedicated Adjusted Recipe Output Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdjustedResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/surfaceStroke"
                    app:cardBackgroundColor="@color/cardSurface"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Ingredients Header & Card Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:id="@+id/txtAdjustedRecipeHeader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="INGREDIENTS (ADJUSTED)"
                                android:textColor="@color/textMuted"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReportAdjusted"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Report Issue"
                                android:textColor="@color/buttonSecondaryText"
                                android:textSize="11sp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyAdjusted"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Save"
                                android:textColor="@color/textPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingHorizontal="6dp" />
                        </LinearLayout>

                        <!-- Indeterminate Progress Indicator -->
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressAnalysisIndicator"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:indeterminate="true"
                            app:indicatorColor="@color/textSecondary"
                            app:trackColor="@color/indicatorTrack"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone" />

                        <!-- Formatted Adjusted Ingredients -->
                        <TextView
                            android:id="@+id/txtAdjustedOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textPrimary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp" />

                        <!-- On-Demand Cooking Steps & Rationale -->
                        <LinearLayout
                            android:id="@+id/layoutPostAnalysisActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRetrieveSteps"
                                style="@style/Widget.LabelScanner.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/textPrimary"
                                android:layout_marginEnd="4dp"
                                android:text="Get Steps"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRetrieveAnalysis"
                                style="@style/Widget.LabelScanner.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/textPrimary"
                                android:layout_marginStart="4dp"
                                android:text="Get Analysis"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Collapsible Original Ingredients Drawer -->
                <TextView
                    android:id="@+id/txtToggleOriginalInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▶ View Original Ingredients"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtOriginalInputCollapsed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/buttonSecondaryText"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:background="@color/headerSurface"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>