<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Soft Glassy Primary Scan Button -->
    <style name="Widget.LabelScanner.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">#3B6E50</item> <!-- Soft Sage Green -->
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Outlined Secondary Settings Button -->
    <style name="Widget.LabelScanner.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">#2E3545</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">#D1D7E0</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Base Application Theme -->
    <style name="Theme.LabelScanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Global Bottom Navigation Style Override -->
        <item name="bottomNavigationStyle">@style/Widget.LabelScanner.BottomNavigationView</item>

        <!-- Global Theme Colors [1] -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Toggle Button Checked States (Overrides purple check background) [1] -->
        <item name="colorPrimaryContainer">#2B1F16</item> <!-- Cocoa-brown active background -->
        <item name="colorOnPrimaryContainer">#E5C158</item> <!-- Warm gold active text -->

        <!-- System-wide Touch Ripple / Pulse (Overrides purple ripple globally!) [2] -->
        <item name="colorControlHighlight">#40E5C158</item> <!-- 25% transparent gold ripple instead of purple -->
    </style>

    <!-- Bottom Navigation Custom Styling -->
    <style name="Widget.LabelScanner.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">#2B1F16</item> <!-- Dark tan / lite brown background -->
        <item name="itemIconTint">@color/bottom_nav_color_state</item> <!-- Fills state selector -->
        <item name="itemTextColor">@color/bottom_nav_color_state</item>
    </style>

    <!-- Base style for the stylized rounded triangle buttons -->
    <style name="StylizedScanButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_gravity">end</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <!-- Rounded triangle/oval shape -->
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.ScanButton</item>
    </style>

    <!-- Specific color variations -->
    <style name="StylizedScanButton.Green">
        <item name="backgroundTint">#22DD55</item> <!-- Green -->
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="StylizedScanButton.Yellow">
        <item name="backgroundTint">#FFD700</item> <!-- Yellow -->
        <item name="android:textColor">#333333</item>
    </style>

    <style name="StylizedScanButton.Blue">
        <item name="backgroundTint">#3399FF</item> <!-- Blue -->
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Defines the "Schmancy" rounded triangle shape overlay -->
    <style name="ShapeAppearanceOverlay.ScanButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
    </style>
</resources>