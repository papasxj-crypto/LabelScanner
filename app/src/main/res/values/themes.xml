<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Primary Action Button (Standardized to Brand Primary Background) -->
    <style name="Widget.LabelScanner.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/buttonPrimaryBackground</item>
        <item name="android:textColor">@color/buttonPrimaryText</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Outlined Secondary Button -->
    <style name="Widget.LabelScanner.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/surfaceStroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Global Dialog Button Styles (High Contrast) -->
    <style name="Widget.LabelScanner.DialogButton.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/surfaceStroke</item>
    </style>

    <style name="Widget.LabelScanner.DialogButton.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/surfaceStroke</item>
    </style>

    <!-- Global Material Alert Dialog Theme Overlay -->
    <style name="ThemeOverlay.LabelScanner.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/cardSurface</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LabelScanner.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LabelScanner.DialogButton.Negative</item>
    </style>

    <!-- Base Application Theme -->
    <style name="Theme.LabelScanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Default background -->
        <item name="android:windowBackground">@color/cardSurface</item>

        <!-- Global Bottom Navigation Style Override -->
        <item name="bottomNavigationStyle">@style/Widget.LabelScanner.BottomNavigationView</item>

        <!-- Global Theme Colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Forces cursor | and water drop handle to Parchment Cream -->
        <item name="colorControlActivated">@color/accentVivid</item>

        <!-- Global Dialog Styles (Applies to MaterialAlertDialogBuilder) -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LabelScanner.MaterialAlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LabelScanner.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LabelScanner.DialogButton.Negative</item>

        <!-- Container Active Tones -->
        <item name="colorPrimaryContainer">@color/buttonPrimaryBackground</item>
        <item name="colorOnPrimaryContainer">@color/textPrimary</item>

        <!-- System-wide Touch Ripple / Pulse -->
        <item name="colorControlHighlight">#33A89890</item>
    </style>

    <!--
      GOOGLE JETPACK STARTING SPLASH THEME
    -->
    <style name="Theme.LabelScanner.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.LabelScanner</item>
    </style>

    <!-- Bottom Navigation Custom Styling -->
    <style name="Widget.LabelScanner.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/headerSurface</item>
        <item name="itemIconTint">@color/bottom_nav_color_state</item>
        <item name="itemTextColor">@color/bottom_nav_color_state</item>
    </style>

    <!-- Base style for the stylized rounded triangle buttons -->
    <style name="StylizedScanButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_gravity">end</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.ScanButton</item>
    </style>

    <!-- Specific color variations -->
    <style name="StylizedScanButton.Green">
        <item name="backgroundTint">@color/gradeSafe</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="StylizedScanButton.Yellow">
        <item name="backgroundTint">@color/gradeCaution</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="StylizedScanButton.Blue">
        <item name="backgroundTint">@color/accentVivid</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Defines the rounded triangle shape overlay -->
    <style name="ShapeAppearanceOverlay.ScanButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
    </style>
</resources>