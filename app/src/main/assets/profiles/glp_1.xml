<?xml version="1.0" encoding="utf-8"?>
<diet_profile id="glp_1" name="GLP-1 Support">
    <!-- Protein & Carbohydrate Feature Flags -->
    <flag name="use_net_carbs">false</flag>
    <flag name="enforce_protein_ratio">true</flag>
    <flag name="enforce_protein_floor">true</flag>
    <flag name="enforce_protein_ceiling">false</flag>

    <!-- Tactical Culinary Intervention Flags -->
    <flag name="avoid_phosphate_additives">false</flag>
    <flag name="prefer_preblended_gf_flour">false</flag>
    <flag name="strictly_avoid_coconut">false</flag>
    <flag name="limit_saturated_fats">true</flag>

    <!-- Core Target Metrics -->
    <nutrient name="sodium" low_max="140" moderate_max="400" is_blacklist="true" />
    <nutrient name="calories" low_max="200" moderate_max="500" is_blacklist="false" />
    <nutrient name="fiber" low_max="3" moderate_max="5" is_blacklist="false" />
    <nutrient name="saturated_fat" low_max="1" moderate_max="2" is_blacklist="true" />
    <nutrient name="carbs" low_max="15" moderate_max="35" is_blacklist="false" />
    <nutrient name="total_fat" low_max="3" moderate_max="5" is_blacklist="true" />
    <nutrient name="added_sugar" low_max="2" moderate_max="5" is_blacklist="true" />
    <nutrient name="total_sugar" low_max="4" moderate_max="10" is_blacklist="false" />

    <!-- Muscle Preservation Protein Floor -->
    <protein_rules snack_min="10" snack_max="999" meal_min="20" meal_max="999" target_ratio="0.10" />

    <!-- Triggers (Erythritol & HFCS cause severe GI distress on GLP-1 medications) -->
    <trigger category="red">HIGH FRUCTOSE CORN SYRUP</trigger>
    <trigger category="red">ERYTHRITOL</trigger>
    <trigger category="yellow">SUCRALOSE</trigger>
    <trigger category="yellow">ASPARTAME</trigger>
</diet_profile>