<?xml version="1.0" encoding="utf-8"?>
<diet_profile id="autoimmune_protocol" name="Autoimmune Protocol (AIP)" exclusivity_group="dietary_pattern">

    <!-- Protein & Ratio Feature Flags (Neutralized for Elimination Diet) -->
    <flag name="enforce_protein_ratio">false</flag>
    <flag name="enforce_protein_floor">false</flag>
    <flag name="enforce_protein_ceiling">false</flag>

    <!-- Tactical Culinary Intervention Flags -->
    <flag name="avoid_phosphate_additives">true</flag>
    <flag name="strictly_avoid_coconut">false</flag>
    <flag name="limit_saturated_fats">false</flag>
    <flag name="prefer_preblended_gf_flour">false</flag>

    <!-- Open Macro Boundaries (No numerical penalties) -->
    <nutrient name="sodium" low_max="0" moderate_max="999" is_blacklist="false" />
    <nutrient name="potassium" low_max="0" moderate_max="999" is_blacklist="false" />
    <nutrient name="carbs" low_max="0" moderate_max="999" is_blacklist="false" />
    <nutrient name="saturated_fat" low_max="0" moderate_max="999" is_blacklist="false" />
    <nutrient name="total_fat" low_max="0" moderate_max="999" is_blacklist="false" />

    <protein_rules snack_min="0" snack_max="999" meal_min="0" meal_max="999" target_ratio="0.0" />

