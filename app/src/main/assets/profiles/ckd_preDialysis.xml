<?xml version="1.0" encoding="utf-8"?>
<diet_profile id="ckd_pre_dialysis" name="CKD Pre-Dialysis" exclusivity_group="ckd_renal_stage">
    <!-- Restrict keto diets from being co-selected -->
    <conflict target="keto" />

    <!-- Explicit feature flags -->
    <flag name="enforce_protein_ratio">false</flag>
    <flag name="enforce_protein_floor">false</flag>
    <flag name="enforce_protein_ceiling">true</flag>

    <!-- CKD Specific Target Metrics -->
    <nutrient name="sodium" low_max="140" moderate_max="300" is_blacklist="true" />
    <nutrient name="potassium" low_max="200" moderate_max="550" is_blacklist="true" />
    <nutrient name="phosphorus" low_max="100" moderate_max="200" is_blacklist="true" />
    <nutrient name="calcium" low_max="200" moderate_max="400" is_blacklist="false" />

    <!-- Core Baseline Nutrition Filters -->
    <nutrient name="saturated_fat" low_max="1" moderate_max="3" is_blacklist="true" />
    <nutrient name="total_fat" low_max="3" moderate_max="10" is_blacklist="false" />
    <nutrient name="total_sugar" low_max="5" moderate_max="10" is_blacklist="false" />
    <nutrient name="added_sugar" low_max="2" moderate_max="5" is_blacklist="false" />
    <nutrient name="carbs" low_max="15" moderate_max="30" is_blacklist="false" />

    <!-- Flat Numeric Protein Evaluation Boundaries (Enforces Max, Ignores Min Floor) -->
    <protein_rules snack_min="0" snack_max="5" meal_min="0" meal_max="15" target_ratio="0.01" />

    <!-- Ingredient Substring Token Triggers -->
    <trigger category="red">SODIUM PHOSPHATE</trigger>
    <trigger category="red">DISODIUM PHOSPHATE</trigger>
    <trigger category="red">TRISODIUM PHOSPHATE</trigger>
    <trigger category="red">DICALCIUM PHOSPHATE</trigger>
    <trigger category="red">HEXAMETAPHOSPHATE</trigger>
    <trigger category="red">PYROPHOSPHATE</trigger>
    <trigger category="red">POLYPHOSPHATE</trigger>
    <trigger category="red">SODIUM NITRITE</trigger>
    <trigger category="red">POTASSIUM CHLORIDE</trigger>
    <trigger category="red">MONOSODIUM GLUTAMATE</trigger>
    <trigger category="red">MSG</trigger>
    <trigger category="red">SODIUM BICARBONATE</trigger>
    <trigger category="red">BRINE</trigger>
    <trigger category="red">HIGH FRUCTOSE CORN SYRUP</trigger>
    <trigger category="red">NSAID</trigger>

    <!-- Current Yellow Triggers -->
    <trigger category="yellow">SUCRALOSE</trigger>
    <trigger category="yellow">ASPARTAME</trigger>

    <!-- New Yellow Additions -->
    <trigger category="yellow">SODIUM ACETATE</trigger>
    <trigger category="yellow">DISODIUM INOSINATE</trigger>
</diet_profile>