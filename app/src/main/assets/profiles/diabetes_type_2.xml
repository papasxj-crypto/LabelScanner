<?xml version="1.0" encoding="utf-8"?>
<diet_profile id="diabetes_type_2" name="Type 2 Diabetes" exclusivity_group="glycemic_control">
    <!-- Explicit feature flags -->
    <flag name="use_net_carbs">true</flag>
    <flag name="enforce_protein_ratio">false</flag>
    <flag name="enforce_protein_floor">false</flag>
    <flag name="enforce_protein_ceiling">false</flag>


    <flag name="avoid_phosphate_additives">false</flag>
    <flag name="prefer_preblended_gf_flour">false</flag>
    <flag name="strictly_avoid_coconut">false</flag>
    <flag name="limit_saturated_fats">true</flag>

    <!-- Glycemic & Baseline Macro Target Metrics -->
    <nutrient name="carbs" low_max="15" moderate_max="30" is_blacklist="false" />
    <nutrient name="total_sugar" low_max="4" moderate_max="8" is_blacklist="true" />
    <nutrient name="added_sugar" low_max="0" moderate_max="2" is_blacklist="true" />
    <nutrient name="saturated_fat" low_max="2" moderate_max="4" is_blacklist="false" />
    <nutrient name="total_fat" low_max="5" moderate_max="15" is_blacklist="false" />
    <nutrient name="sodium" low_max="140" moderate_max="400" is_blacklist="false" />
    <nutrient name="protein" low_max="15" moderate_max="35" is_blacklist="false" />

    <!-- Standard Meal & Snack Boundaries -->
    <protein_rules snack_min="3" snack_max="999" meal_min="15" meal_max="999" target_ratio="0.10" />

    <!-- Red Triggers: Extreme Glycemic Spikers & Refined Sugars -->
    <trigger category="red">HIGH FRUCTOSE CORN SYRUP</trigger>
    <trigger category="red">CORN SYRUP</trigger>
    <trigger category="red">CORN SYRUP SOLIDS</trigger>
    <trigger category="red">DEXTROSE</trigger>
    <trigger category="red">MALTODEXTRIN</trigger>
    <trigger category="red">AGAVE NECTAR</trigger>
    <trigger category="red">MOLASSES</trigger>
    <trigger category="red">FRUIT JUICE CONCENTRATE</trigger>
    <trigger category="red">EVAPORATED CANE JUICE</trigger>
    <trigger category="red">BROWN RICE SYRUP</trigger>
    <trigger category="red">HYDROGENATED STARCH HYDROLYSATE</trigger>

    <!-- Yellow Triggers: Deceptive Sugar Alcohols & High-GI Artificials -->
    <trigger category="yellow">MALTITOL</trigger>
    <trigger category="yellow">SORBITOL</trigger>
    <trigger category="yellow">SUCRALOSE</trigger>
    <trigger category="yellow">ASPARTAME</trigger>
    <trigger category="yellow">SACCHARIN</trigger>
</diet_profile>